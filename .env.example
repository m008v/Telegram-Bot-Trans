# Lấy từ @BotFather. Không commit token thật.
TELEGRAM_BOT_TOKEN=

# Endpoint Google GTX không cần API key, Google Cloud project hay billing.
# Đây là endpoint nội bộ, không có SLA và có thể bị giới hạn hoặc thay đổi bất kỳ lúc nào.

# zh-CN: Trung giản thể; zh-TW: Trung phồn thể.
CHINESE_TARGET_LANGUAGE=zh-CN

# Bot mặc định fail-closed: nếu cả hai dòng dưới đều rỗng/false,
# bot chỉ cho phép /id để lấy chat ID rồi cấu hình allowlist.
# Ví dụ: 123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL_CHATS=false

# Chống spam/đốt giới hạn dịch. Áp dụng trước khi gọi Google.
TELEGRAM_MAX_TRANSLATIONS_PER_MINUTE=20
TELEGRAM_GLOBAL_MAX_TRANSLATIONS_PER_MINUTE=120
MAX_CONCURRENT_TRANSLATIONS=8

# Thời gian chờ tối đa cho một request Google GTX.
TRANSLATION_TIMEOUT_MS=15000
