# Lấy từ @BotFather. Không commit token thật.
TELEGRAM_BOT_TOKEN=

# API key của service account Yandex có role ai.translate.user.
# Không commit key thật. Folder ID chỉ cần khi kiểu xác thực/tài khoản yêu cầu.
YANDEX_TRANSLATE_API_KEY=
YANDEX_TRANSLATE_FOLDER_ID=

# Yandex Translate hiện dùng mã zh cho tiếng Trung; zh-CN cũ vẫn được nhận như alias.
CHINESE_TARGET_LANGUAGE=zh

# Bot mặc định fail-closed: nếu cả hai dòng dưới đều rỗng/false,
# bot chỉ cho phép /id và /addchat từ admin để bootstrap allowlist.
# Ví dụ: 123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL_CHATS=false

# Telegram user ID được phép dùng /addchat trong group để cập nhật allowlist.
# Có thể nhập nhiều ID, phân cách bằng dấu phẩy. Ví dụ: 123456789,987654321
TELEGRAM_ADMIN_IDS=

# Chống spam/đốt quota dịch. Áp dụng trước khi gọi Yandex.
TELEGRAM_MAX_TRANSLATIONS_PER_MINUTE=20
TELEGRAM_GLOBAL_MAX_TRANSLATIONS_PER_MINUTE=120
MAX_CONCURRENT_TRANSLATIONS=8

# Thời gian chờ tối đa cho một request Yandex Translate.
TRANSLATION_TIMEOUT_MS=15000
