# Lấy từ @BotFather. Không commit token thật.
TELEGRAM_BOT_TOKEN=

# Google Cloud project đã bật Cloud Translation API và billing.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Đường dẫn tuyệt đối tới service-account JSON khi chạy local.
# Trên Google Cloud nên dùng Application Default Credentials, không cần biến này.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/trans-bot-service-account.json

# zh-CN: Trung giản thể; zh-TW: Trung phồn thể.
CHINESE_TARGET_LANGUAGE=zh-CN

# Bot mặc định fail-closed: nếu cả hai dòng dưới đều rỗng/false,
# bot chỉ cho phép /id để lấy chat ID rồi cấu hình allowlist.
# Ví dụ: 123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL_CHATS=false

# Chống spam/đốt quota. Áp dụng trước khi gọi Google.
TELEGRAM_MAX_TRANSLATIONS_PER_MINUTE=20
TELEGRAM_GLOBAL_MAX_TRANSLATIONS_PER_MINUTE=120
MAX_CONCURRENT_TRANSLATIONS=8

# Thời gian chờ tối đa cho một request Google Cloud Translation.
TRANSLATION_TIMEOUT_MS=15000

# Từ chối nếu Google nhận diện ngôn ngữ với confidence thấp hơn ngưỡng này.
MIN_LANGUAGE_CONFIDENCE=0.6
